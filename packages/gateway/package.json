{
  "name": "local-decider",
  "version": "0.0.0",
  "description": "Local decision-model gateway for Paseo, Claude Code and Codex: /v1/systemone, policies, shadow log, MCP.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkeLLLa/local-decider.git",
    "directory": "packages/gateway"
  },
  "bin": {
    "local-decider": "./dist/cli.js"
  },
  "files": [
    "dist",
    "policies",
    "schemas",
    "engines/*/pyproject.toml",
    "engines/*/uv.lock",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist policies schemas && tsc -p tsconfig.build.json && cp -r ../../policies policies && cp -r ../../schemas schemas",
    "schemas": "node --conditions=source src/cli.ts config schema ../../schemas && cd ../.. && oxfmt schemas",
    "test": "node --test --conditions=source --experimental-test-coverage --test-coverage-include='src/**' 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@local-decider/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  }
}
