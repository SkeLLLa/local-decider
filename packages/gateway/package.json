{
  "name": "@ziptie-soft/local-decider",
  "version": "2.0.0",
  "description": "Local decision-model gateway and CLI that answers routine coding-agent questions (permissions, command risk, routing, turn outcomes) for Paseo, Claude Code and Codex.",
  "keywords": [
    "ai-agents",
    "claude-code",
    "cli",
    "codex",
    "coding-agents",
    "decision-model",
    "fastflowlm",
    "gateway",
    "local-decider",
    "local-llm",
    "mcp",
    "mlx",
    "model-routing",
    "npu",
    "paseo",
    "permissions"
  ],
  "homepage": "https://github.com/ziptie-soft/local-decider/tree/master/packages/gateway#readme",
  "bugs": {
    "url": "https://github.com/ziptie-soft/local-decider/issues"
  },
  "license": "Apache-2.0",
  "author": "ziptie-soft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziptie-soft/local-decider.git",
    "directory": "packages/gateway"
  },
  "bin": {
    "local-decider": "./dist/cli.js"
  },
  "files": [
    "dist",
    "policies",
    "schemas",
    "engines/*/pyproject.toml",
    "engines/*/uv.lock",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist policies schemas && tsc -p tsconfig.build.json && cp -r ../../policies policies && cp -r ../../schemas schemas",
    "schemas": "node --conditions=source src/cli.ts config schema ../../schemas && cd ../.. && oxfmt schemas",
    "test": "node --test --conditions=source --experimental-test-coverage --test-coverage-include='src/**' 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@ziptie-soft/local-decider-core": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24.15"
  }
}
