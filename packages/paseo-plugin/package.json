{
  "name": "@ziptie-soft/paseo-plugin-local-decider",
  "version": "1.0.2",
  "description": "Paseo plugin for local-decider: auto-allows routine permission prompts, routes new agents to models and flags turns that need you, using a local decision model.",
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "coding-agents",
    "decision-model",
    "local-decider",
    "local-llm",
    "model-routing",
    "paseo",
    "paseo-plugin",
    "permissions"
  ],
  "homepage": "https://github.com/ziptie-soft/local-decider/tree/master/packages/paseo-plugin#readme",
  "bugs": {
    "url": "https://github.com/ziptie-soft/local-decider/issues"
  },
  "license": "Apache-2.0",
  "author": "ziptie-soft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziptie-soft/local-decider.git",
    "directory": "packages/paseo-plugin"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./server": "./index.server.ts",
    "./client": "./index.client.tsx"
  },
  "scripts": {
    "build": "pnpm run typecheck",
    "test": "node --test --conditions=source 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json"
  },
  "dependencies": {
    "@ziptie-soft/local-decider-core": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@getpaseo/client": "0.15.3",
    "@getpaseo/plugin": "0.15.3",
    "@getpaseo/protocol": "0.15.3",
    "@tanstack/react-query": "^5.107.1",
    "@types/react": "~19.2.18",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "engines": {
    "node": ">=24"
  }
}
