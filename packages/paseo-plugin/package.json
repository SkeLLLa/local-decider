{
  "name": "paseo-plugin-local-decider",
  "version": "0.0.0",
  "description": "Paseo plugin for local-decider: turn outcomes, permission triage and model routing through a local System One gateway.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkeLLLa/local-decider.git",
    "directory": "packages/paseo-plugin"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/"
  ],
  "type": "module",
  "exports": {
    "./server": "./index.server.ts",
    "./client": "./index.client.tsx"
  },
  "scripts": {
    "build": "pnpm run typecheck",
    "test": "node --test --conditions=source 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json"
  },
  "devDependencies": {
    "@getpaseo/client": "0.15.3",
    "@getpaseo/plugin": "0.15.3",
    "@getpaseo/protocol": "0.15.3",
    "@local-decider/core": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "@types/react": "~19.2.18",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  }
}
