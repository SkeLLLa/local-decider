{
  "name": "@ziptie-soft/local-decider-core",
  "version": "1.0.2",
  "description": "Shared core for local-decider: /v1/systemone types and client, policy schema and rules, secret redaction and truncation.",
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "coding-agents",
    "decision-model",
    "local-decider",
    "local-llm",
    "paseo",
    "policy",
    "redaction",
    "systemone"
  ],
  "homepage": "https://github.com/ziptie-soft/local-decider/tree/master/packages/core#readme",
  "bugs": {
    "url": "https://github.com/ziptie-soft/local-decider/issues"
  },
  "license": "Apache-2.0",
  "author": "ziptie-soft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziptie-soft/local-decider.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "node --test --conditions=source --experimental-test-coverage --test-coverage-include='src/**' 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  }
}
