{
  "description": "local-decider: deterministic command guard plus local decision-model policies (fail-open; PreToolUse is deny-only on Codex)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/local-decider-hook.sh\" codex PreToolUse",
            "timeout": 5,
            "statusMessage": "local-decider: checking tool call"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/local-decider-hook.sh\" codex PermissionRequest",
            "timeout": 5,
            "statusMessage": "local-decider: reviewing permission request"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/local-decider-hook.sh\" codex UserPromptSubmit",
            "timeout": 5,
            "statusMessage": "local-decider: picking model for prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/local-decider-hook.sh\" codex Stop",
            "timeout": 5,
            "statusMessage": "local-decider: logging turn outcome"
          }
        ]
      }
    ]
  }
}
