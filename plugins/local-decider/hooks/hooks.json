{
  "description": "local-decider: deterministic command guard plus local decision-model policies (fail-open)",
  "modules": ["./local-decider-auto-mode.mjs"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/local-decider-hook.sh\" claude PreToolUse",
            "timeout": 5,
            "statusMessage": "local-decider: checking tool call"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/local-decider-hook.sh\" claude PermissionRequest",
            "timeout": 5,
            "statusMessage": "local-decider: reviewing permission request"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/local-decider-hook.sh\" claude UserPromptSubmit",
            "timeout": 5,
            "statusMessage": "local-decider: picking model for prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/local-decider-hook.sh\" claude Stop",
            "timeout": 5,
            "statusMessage": "local-decider: logging turn outcome"
          }
        ]
      }
    ]
  }
}
