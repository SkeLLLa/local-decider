{
  "$id": "https://raw.githubusercontent.com/SkeLLLa/local-decider/main/schemas/policy.schema.json",
  "title": "local-decider policy",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "Policy id; also the file name (`<id>.yaml`)."
    },
    "version": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "One line: what this decides."
    },
    "variantOf": {
      "description": "Id of the policy this one can answer for when selected (e.g. `routing`).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "mode": {
      "default": "shadow",
      "description": "Default run mode; config.yaml `policies.<id>.mode` overrides it.",
      "type": "string",
      "enum": ["off", "shadow", "act"]
    },
    "priority": {
      "default": "normal",
      "description": "Engine queue priority: `high` for decisions a hook waits on.",
      "type": "string",
      "enum": ["high", "normal", "low"]
    },
    "harnesses": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "maxTokens": {
          "default": 3000,
          "type": "integer",
          "minimum": 128,
          "maximum": 32000
        },
        "sections": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "from": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                "description": "Key of the harness input rendered here, e.g. `prompt`, `project`, `history`."
              },
              "keep": {
                "default": "tail",
                "description": "Which part survives truncation.",
                "type": "string",
                "enum": ["head", "tail", "middle"]
              }
            },
            "required": ["label", "from"],
            "additionalProperties": false
          }
        }
      },
      "required": ["sections"],
      "additionalProperties": false,
      "description": "What the model reads: input keys in order, least relevant first, within maxTokens."
    },
    "precedent": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "description": "Harness input key used for exact-match outcome precedent; never rendered as state."
        },
        "minAllows": {
          "default": 3,
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "maxAgeDays": {
          "default": 14,
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "sources": {
          "default": ["user"],
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["user", "supervised", "harness", "heuristic", "classifier"]
          }
        }
      },
      "required": ["from"],
      "additionalProperties": false
    },
    "questions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "noul"
              },
              "instructions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "criteria": {
                "type": "object",
                "properties": {
                  "true": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 600
                  },
                  "false": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 600
                  }
                },
                "additionalProperties": false
              }
            },
            "required": ["type", "instructions"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "choice"
              },
              "instructions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "criteria": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 600
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "required": ["type", "instructions", "criteria"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "score"
              },
              "instructions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "criteria": {
                "minItems": 2,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                }
              }
            },
            "required": ["type", "instructions", "criteria"],
            "additionalProperties": false
          }
        ],
        "description": "noul: yes/no (answers `true`/`false`); choice: one of 2..255 options (answers the option id); score: ordered levels (answers the level text). Criteria: short, mutually exclusive, with concrete examples."
      }
    },
    "rules": {
      "default": [],
      "description": "Checked in order; the first match wins.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "when": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "answer": {
                "type": "string",
                "minLength": 1
              },
              "minConfidence": {
                "description": "Normalised confidence: 0 = uniform, 1 = certain.",
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minProbability": {
                "description": "Probability of the named answer.",
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "precedent": {
                "type": "string",
                "const": "allow"
              }
            },
            "required": ["question", "answer"],
            "additionalProperties": false
          },
          "action": {
            "type": "string",
            "pattern": "^(?:allow|ask|deny|log|abstain|notify|route:[a-z0-9][a-z0-9_.-]*)$",
            "description": "allow, ask, deny, log, notify, abstain, or route:<preset>."
          }
        },
        "required": ["when", "action"],
        "additionalProperties": false
      }
    },
    "default": {
      "default": "abstain",
      "description": "Action when no rule matches or the engine failed.",
      "type": "string",
      "pattern": "^(?:allow|ask|deny|log|abstain|notify|route:[a-z0-9][a-z0-9_.-]*)$"
    },
    "cache": {
      "default": {
        "ttlSeconds": 0
      },
      "type": "object",
      "properties": {
        "ttlSeconds": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["id", "version", "description", "state", "questions"],
  "additionalProperties": false
}
